# Copie para .env e ajuste. Adicione ".env" ao .gitignore 

# PostgreSQL
POSTGRES_USER=fiapx
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fiapx

# RabbitMQ
RABBITMQ_USER=fiapx
RABBITMQ_PASSWORD=troque-esta-senha

# MinIO — credenciais ROOT (usadas SÓ pelo minio-setup, nunca pela aplicação)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=troque-esta-senha-root
MINIO_BUCKET=videos

# MinIO — credenciais ESCOPADAS da aplicação (privilégio mínimo no bucket)
APP_S3_ACCESS_KEY=fiapx-app
APP_S3_SECRET_KEY=troque-esta-senha-app

# Endpoint público do MinIO (vai dentro das presigned URLs que o browser acessa).
# Dev: localhost. Prod: https://${S3_DOMAIN}
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Auth — gere com: openssl rand -hex 32
JWT_SECRET=gere-um-segredo-longo-e-aleatorio-de-32-bytes-ou-mais

# Retenção de dados (LGPD) — dias até purgar vídeos/zips
RETENTION_DAYS=7

# Observabilidade (overlay)
GRAFANA_PASSWORD=troque-esta-senha-grafana

# Produção (overlay prod) — domínios para o Caddy emitir TLS
API_DOMAIN=api.seu-dominio.com
S3_DOMAIN=s3.seu-dominio.com
